{
  "kind": "collectionType",
  "collectionName": "tournament_matches",
  "info": { "singularName": "match", "pluralName": "matches", "displayName": "Match" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "round": { "type": "integer", "required": true, "min": 1 },
    "position": { "type": "integer", "required": true, "min": 1 },
    "scoreA": { "type": "integer", "min": 0 },
    "scoreB": { "type": "integer", "min": 0 },
    "matchStatus": { "type": "enumeration", "enum": ["pending", "scheduled", "live", "finished"], "required": true, "default": "pending" },
    "scheduledAt": { "type": "datetime" },
    "nextSlot": { "type": "enumeration", "enum": ["A", "B"] },
    "tournament": { "type": "relation", "relation": "manyToOne", "target": "api::tournament.tournament", "inversedBy": "matches" },
    "teamA": { "type": "relation", "relation": "manyToOne", "target": "api::team.team" },
    "teamB": { "type": "relation", "relation": "manyToOne", "target": "api::team.team" },
    "winner": { "type": "relation", "relation": "manyToOne", "target": "api::team.team" },
    "nextMatch": { "type": "relation", "relation": "manyToOne", "target": "api::match.match" }
  }
}
