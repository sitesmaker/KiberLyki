{
  "kind": "collectionType",
  "collectionName": "tournament_registrations",
  "info": { "singularName": "tournament-registration", "pluralName": "tournament-registrations", "displayName": "Tournament registration" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "registrationStatus": { "type": "enumeration", "enum": ["pending", "approved", "rejected", "withdrawn"], "required": true, "default": "pending" },
    "submittedAt": { "type": "datetime", "required": true },
    "rejectionReason": { "type": "text" },
    "seed": { "type": "integer", "min": 1 },
    "tournament": { "type": "relation", "relation": "manyToOne", "target": "api::tournament.tournament", "inversedBy": "registrations" },
    "team": { "type": "relation", "relation": "manyToOne", "target": "api::team.team", "inversedBy": "registrations" },
    "submittedBy": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "players": { "type": "relation", "relation": "oneToMany", "target": "api::registration-player.registration-player", "mappedBy": "registration" }
  }
}
